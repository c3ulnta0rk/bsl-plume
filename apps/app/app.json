{
  "expo": {
    "name": "Plume",
    "slug": "plume",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "plume",
    "userInterfaceStyle": "automatic",
    "ios": { "supportsTablet": true, "bundleIdentifier": "fr.bslplume.app" },
    "android": {
      "package": "fr.bslplume.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1437",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "Plume, tournois de badminton",
      "shortName": "Plume",
      "lang": "fr",
      "themeColor": "#0B1437",
      "backgroundColor": "#0B1437"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-splash-screen", { "backgroundColor": "#0B1437", "image": "./assets/images/splash-icon.png", "imageWidth": 96 }]
    ]
  }
}
