# Copier en .env pour l'hébergement. Aucune de ces variables n'est nécessaire en développement.

# Base PostgreSQL. Sans cette variable, le serveur utilise PGlite dans le dossier PLUME_DATA_DIR.
DATABASE_URL=postgresql://plume:change-moi@db:5432/plume
# PLUME_DATA_DIR=.data/pglite

# Adresse publique du site, utilisée dans les liens des mails.
APP_URL=https://plume.exemple.fr
PORT=4000

# Envoi des mails (confirmation d'inscription, validation). Sans SMTP_URL, les mails sont
# conservés en base et affichés dans le journal du serveur, mais pas envoyés.
SMTP_URL=smtps://utilisateur:motdepasse@smtp.exemple.fr:465
MAIL_FROM=Plume <inscriptions@plume.exemple.fr>

# Contact transmis aux services de notification des navigateurs.
PLUME_CONTACT=mailto:contact@plume.exemple.fr
